<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;

use App\Http\Requests;
use Prettus\Validator\Contracts\ValidatorInterface;
use Prettus\Validator\Exceptions\ValidatorException;
use App\Http\Requests\ServiceAvailabilityLocationCreateRequest;
use App\Http\Requests\ServiceAvailabilityLocationUpdateRequest;
use App\Repositories\ServiceAvailabilityLocationRepository;
use App\Validators\ServiceAvailabilityLocationValidator;

/**
 * Class ServiceAvailabilityLocationsController.
 *
 * @package namespace App\Http\Controllers;
 */
class ServiceAvailabilityLocationsController extends Controller
{
    /**
     * @var ServiceAvailabilityLocationRepository
     */
    protected $repository;

    /**
     * @var ServiceAvailabilityLocationValidator
     */
    protected $validator;

    /**
     * ServiceAvailabilityLocationsController constructor.
     *
     * @param ServiceAvailabilityLocationRepository $repository
     * @param ServiceAvailabilityLocationValidator $validator
     */
    public function __construct(ServiceAvailabilityLocationRepository $repository, ServiceAvailabilityLocationValidator $validator)
    {
        $this->repository = $repository;
        $this->validator  = $validator;
    }

    /**
     * Display a listing of the resource.
     *
     * @return \Illuminate\Http\Response
     */
    public function index()
    {
        $this->repository->pushCriteria(app('Prettus\Repository\Criteria\RequestCriteria'));
        $serviceAvailabilityLocations = $this->repository->all();

        if (request()->wantsJson()) {

            return response()->json([
                'data' => $serviceAvailabilityLocations,
            ]);
        }

        return view('serviceAvailabilityLocations.index', compact('serviceAvailabilityLocations'));
    }

    /**
     * Store a newly created resource in storage.
     *
     * @param  ServiceAvailabilityLocationCreateRequest $request
     *
     * @return \Illuminate\Http\Response
     *
     * @throws \Prettus\Validator\Exceptions\ValidatorException
     */
    public function store(ServiceAvailabilityLocationCreateRequest $request)
    {
        try {

            $this->validator->with($request->all())->passesOrFail(ValidatorInterface::RULE_CREATE);

            $serviceAvailabilityLocation = $this->repository->create($request->all());

            $response = [
                'message' => 'ServiceAvailabilityLocation created.',
                'data'    => $serviceAvailabilityLocation->toArray(),
            ];

            if ($request->wantsJson()) {

                return response()->json($response);
            }

            return redirect()->back()->with('message', $response['message']);
        } catch (ValidatorException $e) {
            if ($request->wantsJson()) {
                return response()->json([
                    'error'   => true,
                    'message' => $e->getMessageBag()
                ]);
            }

            return redirect()->back()->withErrors($e->getMessageBag())->withInput();
        }
    }

    /**
     * Display the specified resource.
     *
     * @param  int $id
     *
     * @return \Illuminate\Http\Response
     */
    public function show($id)
    {
        $serviceAvailabilityLocation = $this->repository->find($id);

        if (request()->wantsJson()) {

            return response()->json([
                'data' => $serviceAvailabilityLocation,
            ]);
        }

        return view('serviceAvailabilityLocations.show', compact('serviceAvailabilityLocation'));
    }

    /**
     * Show the form for editing the specified resource.
     *
     * @param  int $id
     *
     * @return \Illuminate\Http\Response
     */
    public function edit($id)
    {
        $serviceAvailabilityLocation = $this->repository->find($id);

        return view('serviceAvailabilityLocations.edit', compact('serviceAvailabilityLocation'));
    }

    /**
     * Update the specified resource in storage.
     *
     * @param  ServiceAvailabilityLocationUpdateRequest $request
     * @param  string            $id
     *
     * @return Response
     *
     * @throws \Prettus\Validator\Exceptions\ValidatorException
     */
    public function update(ServiceAvailabilityLocationUpdateRequest $request, $id)
    {
        try {

            $this->validator->with($request->all())->passesOrFail(ValidatorInterface::RULE_UPDATE);

            $serviceAvailabilityLocation = $this->repository->update($request->all(), $id);

            $response = [
                'message' => 'ServiceAvailabilityLocation updated.',
                'data'    => $serviceAvailabilityLocation->toArray(),
            ];

            if ($request->wantsJson()) {

                return response()->json($response);
            }

            return redirect()->back()->with('message', $response['message']);
        } catch (ValidatorException $e) {

            if ($request->wantsJson()) {

                return response()->json([
                    'error'   => true,
                    'message' => $e->getMessageBag()
                ]);
            }

            return redirect()->back()->withErrors($e->getMessageBag())->withInput();
        }
    }


    /**
     * Remove the specified resource from storage.
     *
     * @param  int $id
     *
     * @return \Illuminate\Http\Response
     */
    public function destroy($id)
    {
        $deleted = $this->repository->delete($id);

        if (request()->wantsJson()) {

            return response()->json([
                'message' => 'ServiceAvailabilityLocation deleted.',
                'deleted' => $deleted,
            ]);
        }

        return redirect()->back()->with('message', 'ServiceAvailabilityLocation deleted.');
    }
}
